PORT=4000
PLAYBAM_WEB_BASE_URL=https://vidimose.hr
PLAYBAM_API_BASE_URL=https://api.vidimose.hr
# Komentari samo s # (// nije komentar u .env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.vidimose.hr/api/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=zamijeni-s-jakim-random-secretom
# Google Places API (New) za parkove: nearby cafes + photo URI proxy. Držati samo na backendu.
GOOGLE_PLACES_API_KEY=
RESEND_API_KEY=
# OG za WhatsApp: Playwright screenshot /pozivnica/:slug?ogCapture=1 (zadano)
# Na serveru: npx playwright install chromium  (+ install-deps na Linuxu)
# OG_USE_SCREENSHOT=false — preskoči Playwright (koristi upload JPG ili SVG fallback)
# Generirani OG: JPEG ~200–600 KB (keš: data/og-render-cache/, invalidira se kad se pozivnica spremi)
# OG_STALE_WHILE_REVALIDATE=false — čekaj puni render (sporije, više opterećenja)
# Playwright se zatvara nakon svakog rendera da ne guši RAM/API
